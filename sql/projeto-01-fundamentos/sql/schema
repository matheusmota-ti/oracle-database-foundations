-- Oracle Baseball League (OBL)
-- Criação do esquema relacional. Compatível com Oracle Database.

CREATE TABLE cliente (
    id_cliente       NUMBER GENERATED BY DEFAULT AS IDENTITY,
    nome             VARCHAR2(120) NOT NULL,
    email            VARCHAR2(150),
    telefone         VARCHAR2(25),
    tipo_cliente     VARCHAR2(15) DEFAULT 'INDIVIDUAL' NOT NULL,
    endereco         VARCHAR2(200),
    CONSTRAINT pk_cliente PRIMARY KEY (id_cliente),
    CONSTRAINT ck_cliente_tipo CHECK (tipo_cliente IN ('INDIVIDUAL', 'REPRESENTANTE_EQUIPE'))
);

CREATE TABLE equipe (
    id_equipe             NUMBER GENERATED BY DEFAULT AS IDENTITY,
    nome                  VARCHAR2(120) NOT NULL,
    quantidade_jogadores  NUMBER(3) DEFAULT 0 NOT NULL,
    percentual_desconto   NUMBER(5,2) DEFAULT 0 NOT NULL,
    CONSTRAINT pk_equipe PRIMARY KEY (id_equipe),
    CONSTRAINT ck_equipe_jogadores CHECK (quantidade_jogadores >= 0),
    CONSTRAINT ck_equipe_desconto CHECK (percentual_desconto BETWEEN 0 AND 100)
);

CREATE TABLE representante (
    id_representante NUMBER GENERATED BY DEFAULT AS IDENTITY,
    nome             VARCHAR2(120) NOT NULL,
    email            VARCHAR2(150),
    telefone         VARCHAR2(25),
    CONSTRAINT pk_representante PRIMARY KEY (id_representante),
    CONSTRAINT uq_representante_email UNIQUE (email)
);

CREATE TABLE produto (
    id_produto          NUMBER GENERATED BY DEFAULT AS IDENTITY,
    nome                VARCHAR2(120) NOT NULL,
    categoria           VARCHAR2(60) NOT NULL,
    descricao           VARCHAR2(300),
    preco_lista         NUMBER(10,2) NOT NULL,
    quantidade_estoque  NUMBER(8) DEFAULT 0 NOT NULL,
    ativo               CHAR(1) DEFAULT 'S' NOT NULL,
    CONSTRAINT pk_produto PRIMARY KEY (id_produto),
    CONSTRAINT ck_produto_preco CHECK (preco_lista >= 0),
    CONSTRAINT ck_produto_estoque CHECK (quantidade_estoque >= 0),
    CONSTRAINT ck_produto_ativo CHECK (ativo IN ('S', 'N'))
);

CREATE TABLE pedido (
    id_pedido          NUMBER GENERATED BY DEFAULT AS IDENTITY,
    id_cliente         NUMBER NOT NULL,
    id_equipe          NUMBER,
    id_representante   NUMBER,
    data_pedido        DATE DEFAULT SYSDATE NOT NULL,
    status             VARCHAR2(20) DEFAULT 'ABERTO' NOT NULL,
    observacao         VARCHAR2(300),
    CONSTRAINT pk_pedido PRIMARY KEY (id_pedido),
    CONSTRAINT fk_pedido_cliente FOREIGN KEY (id_cliente) REFERENCES cliente(id_cliente),
    CONSTRAINT fk_pedido_equipe FOREIGN KEY (id_equipe) REFERENCES equipe(id_equipe),
    CONSTRAINT fk_pedido_representante FOREIGN KEY (id_representante) REFERENCES representante(id_representante),
    CONSTRAINT ck_pedido_status CHECK (status IN ('ABERTO', 'PAGO', 'ENVIADO', 'CONCLUIDO', 'CANCELADO'))
);

CREATE TABLE item_pedido (
    id_item_pedido       NUMBER GENERATED BY DEFAULT AS IDENTITY,
    id_pedido            NUMBER NOT NULL,
    id_produto           NUMBER NOT NULL,
    quantidade           NUMBER(6) NOT NULL,
    preco_unitario       NUMBER(10,2) NOT NULL,
    percentual_desconto  NUMBER(5,2) DEFAULT 0 NOT NULL,
    CONSTRAINT pk_item_pedido PRIMARY KEY (id_item_pedido),
    CONSTRAINT fk_item_pedido_pedido FOREIGN KEY (id_pedido) REFERENCES pedido(id_pedido),
    CONSTRAINT fk_item_pedido_produto FOREIGN KEY (id_produto) REFERENCES produto(id_produto),
    CONSTRAINT uq_item_pedido_produto UNIQUE (id_pedido, id_produto),
    CONSTRAINT ck_item_quantidade CHECK (quantidade > 0),
    CONSTRAINT ck_item_preco CHECK (preco_unitario >= 0),
    CONSTRAINT ck_item_desconto CHECK (percentual_desconto BETWEEN 0 AND 100)
);

CREATE TABLE reclamacao (
    id_reclamacao       NUMBER GENERATED BY DEFAULT AS IDENTITY,
    id_cliente          NUMBER NOT NULL,
    id_representante    NUMBER NOT NULL,
    data_reclamacao     DATE DEFAULT SYSDATE NOT NULL,
    descricao           VARCHAR2(1000) NOT NULL,
    status              VARCHAR2(20) DEFAULT 'ABERTA' NOT NULL,
    CONSTRAINT pk_reclamacao PRIMARY KEY (id_reclamacao),
    CONSTRAINT fk_reclamacao_cliente FOREIGN KEY (id_cliente) REFERENCES cliente(id_cliente),
    CONSTRAINT fk_reclamacao_representante FOREIGN KEY (id_representante) REFERENCES representante(id_representante),
    CONSTRAINT ck_reclamacao_status CHECK (status IN ('ABERTA', 'EM_ANALISE', 'RESOLVIDA', 'CANCELADA'))
);

CREATE INDEX idx_pedido_cliente ON pedido(id_cliente);
CREATE INDEX idx_pedido_equipe ON pedido(id_equipe);
CREATE INDEX idx_item_produto ON item_pedido(id_produto);
CREATE INDEX idx_reclamacao_cliente ON reclamacao(id_cliente);

-- Fim do esquema.
